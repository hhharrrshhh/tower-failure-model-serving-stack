{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "type": "timeseries",
      "title": "Throughput / Request Rate (RPS)",
      "description": "Incoming HTTP request rate grouped by endpoint and response code",
      "targets": [
        {
          "expr": "sum(rate(tower_serving_http_requests_total[30s])) by (endpoint, status_code)",
          "legendFormat": "{{endpoint}} ({{status_code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "type": "timeseries",
      "title": "Latency Percentiles (p50, p95, p99)",
      "description": "Response latency across percentiles measured on /predict",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(tower_serving_http_request_duration_seconds_bucket{endpoint='/predict'}[1m])) by (le)) * 1000",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tower_serving_http_request_duration_seconds_bucket{endpoint='/predict'}[1m])) by (le)) * 1000",
          "legendFormat": "p95 (SLA Threshold: 80ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(tower_serving_http_request_duration_seconds_bucket{endpoint='/predict'}[1m])) by (le)) * 1000",
          "legendFormat": "p99 (Tail Latency)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "type": "timeseries",
      "title": "HTTP Error Rate (%)",
      "description": "Percentage of requests returning 4xx or 5xx status codes",
      "targets": [
        {
          "expr": "(sum(rate(tower_serving_http_requests_total{status_code=~'4..|5..'}[1m])) / sum(rate(tower_serving_http_requests_total[1m]))) * 100",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "type": "timeseries",
      "title": "Share of 'Failure' Predictions (%) vs Historical Baseline",
      "description": "Proportion of towers predicted to fail within 48h. Baseline is ~20.8%. Alert fires at >45%.",
      "targets": [
        {
          "expr": "((sum(rate(tower_serving_predictions_total{prediction_class='1'}[1m])) or vector(0)) / (sum(rate(tower_serving_predictions_total[1m])) > 0)) * 100",
          "legendFormat": "Failure Prediction Share (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30.0 },
              { "color": "red", "value": 45.0 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "type": "timeseries",
      "title": "Process Memory & System Resources",
      "description": "FastAPI resident memory usage and CPU runtime seconds",
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "Process RSS Memory (MB)",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "Process CPU (%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "tower-serving"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Tower Failure Serving Stack - Live Telemetry",
  "uid": "tower-serving-telemetry",
  "version": 1
}
